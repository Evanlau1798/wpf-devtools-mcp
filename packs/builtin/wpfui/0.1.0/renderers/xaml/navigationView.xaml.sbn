<ui:NavigationView PaneDisplayMode="{{paneDisplayMode}}" IsPaneOpen="{{isPaneOpen}}" OpenPaneLength="{{openPaneLength}}" IsBackButtonVisible="{{isBackButtonVisible}}" IsPaneToggleVisible="False">
  <ui:NavigationView.AutoSuggestBox>
    <ui:AutoSuggestBox Visibility="Collapsed" />
  </ui:NavigationView.AutoSuggestBox>
  <ui:NavigationView.MenuItems>{{slot.items}}</ui:NavigationView.MenuItems>
  <ui:NavigationView.FooterMenuItems>{{slot.footer}}</ui:NavigationView.FooterMenuItems>
  <ui:NavigationView.ContentOverlay>
    <Grid>{{slot.content}}</Grid>
  </ui:NavigationView.ContentOverlay>
</ui:NavigationView>
